# InsightAI Frontend — Environment Template
# Copy to .env for local dev: cp .env.example .env
# On Vercel: set in Dashboard → Settings → Environment Variables

# Primary backend URL (Fly.io in prod, localhost in dev)
VITE_API_BASE_URL=http://localhost:8000
# Example prod: VITE_API_BASE_URL=https://insightai-api.fly.dev

# Optional fallback (frontend/api.ts:7 will try fallback if primary fails)
# VITE_API_FALLBACK_BASE_URL=http://localhost:8000

# Optional: override request timeout (ms)
# VITE_API_TIMEOUT_MS=100000
