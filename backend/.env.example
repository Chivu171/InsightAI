# InsightAI Backend — Environment Template
# Copy to .env and fill values: cp .env.example .env
# On Fly.io: fly secrets set KEY=VALUE (do not commit .env)

# ── App ──────────────────────────────────────────────────────────
ENV=development
# ENV=production  # set on Fly
DEBUG=false
APP_NAME=InsightAI API

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated origins. Must include Vercel frontend URL in prod.
# Example dev: http://localhost:5173
# Example prod: https://insightai.vercel.app,https://insightai-api.fly.dev
CORS_ORIGINS=http://localhost:5173,https://insightai.vercel.app
# Safety net: if CORS_ORIGINS is empty in production, fall back to this list
# instead of crashing. Recommended for first deploy.
# CORS_ORIGINS_DEFAULT=https://insightai.vercel.app

# ── LLM Providers ────────────────────────────────────────────────
# Primary: OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL_API=https://openrouter.ai/api/v1
OPENROUTER_MODEL_NAME=deepseek/deepseek-v4-flash:free
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=InsightAI

# Fallback 1: Local LM Studio (OpenAI-compatible)
LMSTUDIO_BASE_URL=http://127.0.0.1:1234
LMSTUDIO_MODEL=your-local-model-name

# Fallback 2: Google Gemini
GOOGLE_API_KEY=your-google-api-key
GOOGLE_MODEL=gemini-2.5-flash

# ── Embeddings & Retrieval ───────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Dev: vector_db / Prod on Fly (with volume): /data/vector_db
VECTOR_DB_PATH=vector_db
UPLOAD_DIR=uploads
CHUNK_SIZE=600
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=3

# ── Conversation Memory ──────────────────────────────────────────
MAX_TURNS=15
REWRITE_HISTORY_TURNS=5
SESSION_TTL_SECONDS=86400
# Upstash Redis (optional, recommended on Fly when scaling to 2 machines)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── HuggingFace Cache ────────────────────────────────────────────
# Dev: ./hf_cache / Prod on Fly: /data/hf_cache (persisted on volume)
HF_HOME=./hf_cache
